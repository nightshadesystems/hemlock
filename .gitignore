/target
**/*.rs.bk

# Vendor blobs are never committed (see vendor/sai/README.md)
vendor/sai/*
!vendor/sai/README.md
!vendor/sai/.gitkeep
# Broadcom LED toolchain, fetched by vendor/fetch-ledtools.sh
vendor/ledtools/
platforms/**/*.bcm
platforms/**/*.soc
platforms/**/*.deb

# Build outputs
/build/out/
*.bin
*.squashfs

# Local state from dev runs
/.hemlock-state/

