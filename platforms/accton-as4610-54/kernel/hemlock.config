# hemlock.config — kernel config fragment for the AS4610-54T.
#
# Merged over multi_v7_defconfig by build-kernel.sh (merge_config.sh),
# so this lists only what that base must additionally guarantee: the
# SoC, every driver the device tree names, and what the Hemlock stack
# reads at runtime. Boot-critical drivers are =y — the rootfs arrives
# over USB, so nothing on the path to mounting it may live in a module
# the rootfs would have to provide.

# --- Version: exactly LOCALVERSION, nothing appended -----------------
# multi_v7_defconfig has LOCALVERSION_AUTO=y, which stamps "-dirty" on
# any unclean tree — and build-kernel.sh always dirties the tree (the
# copied dts + the appended Makefile line). The deb names must be
# deterministic: mkimage.sh globs on ...-hemlock-iproc.
CONFIG_LOCALVERSION_AUTO=n

# --- SoC: XGS iProc via the Hurricane 2 machine (see dts/README) -----
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM_HR2=y
CONFIG_SMP=y
# 2 GB of RAM on a 32-bit kernel.
CONFIG_HIGHMEM=y

# --- Console: ns16550a pair -----------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- The USB boot path, end to end, all built in --------------------
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# --- Management ethernet: AMAC + iProc MDIO + the external PHY ------
CONFIG_BGMAC=y
CONFIG_BGMAC_PLATFORM=y
CONFIG_MDIO_BCM_IPROC=y
CONFIG_BROADCOM_PHY=y

# --- I2C: the two SMBus roots, the mux, and pmon's raw access -------
CONFIG_I2C=y
CONFIG_I2C_BCM_IPROC=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y

# --- SPI-NOR: U-Boot environment for the installer/fw_setenv --------
CONFIG_SPI=y
CONFIG_SPI_BCM_QSPI=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_BLOCK=y

# --- The manifest's sensors (modules are fine: post-boot) -----------
CONFIG_HWMON=y
CONFIG_SENSORS_LM77=m
CONFIG_EEPROM_AT24=m

# --- Watchdog --------------------------------------------------------
CONFIG_ARM_SP805_WATCHDOG=m

# --- Deliberately off ------------------------------------------------
# No RTC drivers for the dead-battery M41T11: the manifest keeps it off
# the bus and NTP owns the clock (platform README, known quirks).
CONFIG_RTC_DRV_M41T80=n
