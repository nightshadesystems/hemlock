# Optional debugging fragment — NOT part of a release kernel.
#
# Apply with:  HEMLOCK_KERNEL_EXTRA_CONFIG=debug-ll.config build-kernel.sh
#
# Why this exists: a kernel that dies before parse_early_param() has no
# console at all, so it fails identically to a kernel that was never
# entered — "Starting kernel ..." and then nothing, forever. earlycon
# cannot help, because earlycon is itself set up by parse_early_param.
# DEBUG_LL writes straight to the UART from head.S and from the zImage
# decompressor, before the MMU and before any console infrastructure
# exists, which is the only way to tell those two cases apart.
#
# Addresses, from bcm-hx4.dtsi: the APB bus maps 0x18000000 and uart0
# sits at offset 0x300, so the console UART is at 0x18000300. It is a
# byte-wide ns16550a (mainline's bcm-hr2.dtsi/bcm-nsp.dtsi declare no
# reg-shift or reg-io-width), hence SHIFT=0 and no _WORD access.
#
# DEBUG_UART_VIRT is the fixed early-mapping window ARM uses for
# DEBUG_LL on multiplatform kernels: 0xf0000000 + the low bits of the
# physical address.
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_8250=y
CONFIG_DEBUG_UART_8250=y
CONFIG_DEBUG_UART_PHYS=0x18000300
CONFIG_DEBUG_UART_VIRT=0xf0000300
CONFIG_DEBUG_UART_8250_SHIFT=0
CONFIG_EARLY_PRINTK=y
