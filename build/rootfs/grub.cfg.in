# Hemlock GRUB configuration (rendered by mkimage.sh)
serial --port=auto --speed=@CONSOLE_SPEED@
terminal_input serial console
terminal_output serial console

set default=0
set timeout=5

menuentry "Hemlock @VERSION@" {
    search --no-floppy --label HEMLOCK --set root
    linux /boot/vmlinuz console=ttyS@CONSOLE_DEV@,@CONSOLE_SPEED@n8 root=LABEL=HEMLOCK hemlock.rootfs=/hemlock/rootfs.squashfs rw
    initrd /boot/initrd.img
}

menuentry "ONIE (rescue / uninstall)" {
    search --no-floppy --label ONIE-BOOT --set root
    chainloader +1
}
