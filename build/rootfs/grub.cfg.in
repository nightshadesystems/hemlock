# Hemlock GRUB configuration (rendered by mkimage.sh)
serial --port=auto --speed=@CONSOLE_SPEED@
terminal_input serial console
terminal_output serial console

set default=0
set timeout=5

menuentry "Hemlock @VERSION@" {
    search --no-floppy --label HEMLOCK --set root
    # net.ifnames=0: classic eth0 naming, so the manifests' [management]
    # os_device matches (syncd also reads eth0's MAC as the switch source
    # MAC fallback when the syseeprom is not up yet).
    linux /boot/vmlinuz console=ttyS@CONSOLE_DEV@,@CONSOLE_SPEED@n8 root=LABEL=HEMLOCK hemlock.rootfs=/hemlock/rootfs.squashfs rw net.ifnames=0 biosdevname=0
    initrd /boot/initrd.img
}

menuentry "ONIE (rescue / uninstall)" {
    search --no-floppy --label ONIE-BOOT --set root
    chainloader +1
}
