[Unit]
Description=Hemlock SAI sync daemon
# The platform overlay is placed at install time (reachable via the
# /hemlock -> /host/hemlock symlink); the manifest's [kernel]
# required_modules are built into the image by mkimage.sh and modprobed
# by syncd itself at startup.
After=local-fs.target
Before=hemlock-mgmtd.service hemlock-orch.service

[Service]
# Type=notify: syncd sends READY=1 once the switch is created and the
# port table is built, so Before=mgmtd/orch ordering gates on the ASIC
# actually being ready. Helix4 SDK init takes tens of seconds on a cold
# boot; give it generous room before systemd declares failure.
Type=notify
TimeoutStartSec=300
# --auto-mock: fall back to the mock SAI backend when no Broadcom ASIC is
# visible on PCI (QEMU boot tests, bench machines); real hardware still
# gets the vendor backend and hard failures.
ExecStart=/usr/sbin/hemlock-syncd --platform /hemlock/platform --platforms-dir /hemlock --auto-mock
Restart=on-failure
RestartSec=5
RuntimeDirectory=hemlock
RuntimeDirectoryPreserve=yes
# Broadcom's SAI SyncDB writes its files (brcm_sai_syncdb.dat, nvram/,
# debug/) relative to the daemon's working directory; give it a real,
# persistent state dir instead of wherever the daemon happened to start.
StateDirectory=hemlock
WorkingDirectory=/var/lib/hemlock

[Install]
WantedBy=multi-user.target
