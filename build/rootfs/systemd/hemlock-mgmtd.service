[Unit]
Description=Hemlock management daemon (commit engine)
After=hemlock-syncd.service
Wants=hemlock-syncd.service

[Service]
Type=exec
ExecStart=/usr/sbin/hemlock-mgmtd --state-dir /hemlock/persist/config
Restart=on-failure
RestartSec=5
RuntimeDirectory=hemlock
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
