[Unit]
Description=Hemlock platform monitoring daemon
After=local-fs.target

[Service]
Type=exec
# --auto-mock: mock hardware backend only when no Broadcom ASIC is on the
# PCI bus (QEMU boot tests, bench machines). On a switch the sysfs path is
# taken and bring-up failures stay fatal — never mock data on real iron.
ExecStart=/usr/sbin/hemlock-pmon --platform /hemlock/platform --platforms-dir /hemlock --auto-mock
Restart=on-failure
RestartSec=5
RuntimeDirectory=hemlock
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
