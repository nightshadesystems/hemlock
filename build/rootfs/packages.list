# Debian 13 (trixie) package set for the Hemlock rootfs (debootstrap
# --include list; one package per line, comments allowed).
systemd
systemd-sysv
systemd-timesyncd
udev
kmod
dbus
linux-image-amd64
initramfs-tools
grub-pc
openssh-server
sudo
ca-certificates
curl
less
vim-tiny
# networking basics
iproute2
# The protocol stack (OSPFv2, BGP, VRRP): mgmtd renders /etc/frr/frr.conf
# + daemons from the config and reloads. Debian 13 ships FRR 10.x; the
# routing suite pins the distro package rather than an upstream build.
frr
frr-pythontools
# The 802.1X authenticator (wired driver on the hostif netdevs; hostapd
# is the RADIUS client). Unlike FRR, orch owns it end to end: it renders
# the config, manages the process, and watches the control socket.
hostapd
ethtool
iputils-ping
# setcap for ping's cap_net_raw (see the operator-account section)
libcap2-bin
tcpdump
# vendor SAI runtime dependencies (libsaibcm: Depends libstdc++6, libyaml-0-2)
libstdc++6
libyaml-0-2
# platform access
i2c-tools
lm-sensors
pciutils
usbutils
