#!/bin/sh
# initramfs-tools hook: modules the hemlock local-bottom script needs to
# loop-mount the squashfs and build the persistent overlay root.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in
    prereqs) prereqs; exit 0 ;;
esac
. /usr/share/initramfs-tools/hook-functions
manual_add_modules squashfs overlay loop
